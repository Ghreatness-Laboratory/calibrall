# MATCHMIND Football Prediction & Market Intelligence Platform
# Environment Configuration Template

# Application Environment ('development' | 'production' | 'test')
ENVIRONMENT=development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3000/api/v1

# Supabase Managed Database & Auth Configuration
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: Never expose service-role key in public or client bundles
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.your-project-id:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Authentication Secret
AUTH_SECRET=generate-a-secure-random-32-byte-hex-string

# Football Data Provider Integration (football-data.org, API-Football, Sportmonks)
# When left blank or unconfigured, system operates in isolated 'DEVELOPMENT_SEED_MODE'
FOOTBALL_DATA_PROVIDER=football-data.org
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=

# Pre-Match & Historical Odds Provider (e.g. The Odds API)
ODDS_PROVIDER=the-odds-api
ODDS_API_KEY=

# Payments & Subscription Webhooks (e.g. Stripe)
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Notifications & Transactional Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
NOTIFICATION_FROM_ADDRESS=intel@matchmind.app

# Optional Background Queue & Caching (Upstash / Redis)
REDIS_URL=
